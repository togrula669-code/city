NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:3001

# auto selects Groq when its key is present, otherwise Gemini.
# Explicit values: groq | gemini | auto
AI_PROVIDER=groq

# Groq models checked against official documentation on 2026-10-08.
# Always run npm run groq:models to confirm models available to your key.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_AUDIO_MODEL=whisper-large-v3-turbo

# Groq does not provide direct video analysis in this implementation.
# Set to gemini only if you explicitly want video routed to Gemini.
GROQ_VIDEO_FALLBACK=none
GEMINI_API_KEY=
GEMINI_MODEL=

# Set a private token to enable operations dashboard editing.
ADMIN_TOKEN=
DATABASE_MODE=local
LOCAL_DB_FILE=data/db.json
DUPLICATE_RADIUS_METERS=50

# Optional private local evidence archive; keep OFF unless user consent and local disk are appropriate.
# Original bytes are otherwise discarded after analysis.
EVIDENCE_STORAGE=none
EVIDENCE_DIRECTORY=data/evidence
# With AI_PROVIDER=groq, short videos are sampled to image frames in the browser.
# This is visual-only video analysis and does not transcribe soundtrack.
